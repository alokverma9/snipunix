{
  "app-id": "io.github.alokverma9.snipunix.Beta",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "snipunix",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-videos"
  ],
  "modules": [
    {
      "name": "snipunix-ocr-models",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 text-detection.onnx ${FLATPAK_DEST}/share/snipunix/models/text-detection.onnx",
        "install -Dm644 text-recognition.onnx ${FLATPAK_DEST}/share/snipunix/models/text-recognition.onnx"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://ocrs-models.s3-accelerate.amazonaws.com/text-detection.onnx",
          "sha256": "a917b23dbd9524b465df7e922641b3ff2981623df4ded5a0234004ef2fee7cfe",
          "dest-filename": "text-detection.onnx"
        },
        {
          "type": "file",
          "url": "https://ocrs-models.s3-accelerate.amazonaws.com/text-recognition.onnx",
          "sha256": "86c145c2edb96c8caed5b1ebb8f44d706408922211451c309c625157dd6061c5",
          "dest-filename": "text-recognition.onnx"
        }
      ]
    },
    {
      "name": "snipunix",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/snipunix/cargo",
          "CARGO_NET_OFFLINE": "true",
          "SNIPUNIX_APP_ID": "io.github.alokverma9.snipunix.Beta"
        }
      },
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo build --offline --release --locked --bin snipunix",
        "install -Dm755 target/release/snipunix ${FLATPAK_DEST}/bin/snipunix",
        "for locale in de es; do install -Dm644 crates/snipunix-i18n/locales/$locale/LC_MESSAGES/snipunix.mo ${FLATPAK_DEST}/share/locale/$locale/LC_MESSAGES/snipunix.mo; done",
        "install -Dm644 data/io.github.alokverma9.snipunix.Beta.desktop ${FLATPAK_DEST}/share/applications/io.github.alokverma9.snipunix.Beta.desktop",
        "install -Dm644 data/io.github.alokverma9.snipunix.Beta.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.alokverma9.snipunix.Beta.metainfo.xml",
        "install -Dm644 data/io.github.alokverma9.snipunix.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.alokverma9.snipunix.Beta.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            ".git",
            "flatpak"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
