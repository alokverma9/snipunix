{
  "app-id": "io.github.alokverma9.snipunix",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "snipunix",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "snipunix",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/snipunix/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo build --offline --release --locked --bin snipunix",
        "install -Dm755 target/release/snipunix ${FLATPAK_DEST}/bin/snipunix",
        "install -Dm644 data/io.github.alokverma9.snipunix.desktop ${FLATPAK_DEST}/share/applications/io.github.alokverma9.snipunix.desktop",
        "install -Dm644 data/io.github.alokverma9.snipunix.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.alokverma9.snipunix.metainfo.xml",
        "install -Dm644 data/io.github.alokverma9.snipunix.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.alokverma9.snipunix.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            ".git",
            "flatpak"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
