msgid "The download stopped unexpectedly."
msgstr "Der Download wurde unerwartet beendet."

msgid "The screenshot portal is unavailable: {0}. Install xdg-desktop-portal and a desktop backend."
msgstr "Das Screenshot-Portal ist nicht verfügbar: {0}. Installieren Sie xdg-desktop-portal und ein Backend für Ihre Arbeitsfläche."

msgid "The selected export location is not a local file."
msgstr "Der gewählte Exportort ist keine lokale Datei."

msgid "The selected location is not a local file."
msgstr "Der gewählte Ort ist keine lokale Datei."

msgid "The selected region does not fit the recorded monitor."
msgstr "Der gewählte Bereich passt nicht auf den aufgezeichneten Monitor."

msgid "The selected region is not entirely inside the recorded monitor. Record again and choose the monitor that contains it."
msgstr "Der gewählte Bereich liegt nicht vollständig auf dem aufgezeichneten Monitor. Nehmen Sie erneut auf und wählen Sie den Monitor, der ihn enthält."

msgid "There is no captured image to copy yet."
